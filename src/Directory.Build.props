<Project>

  <PropertyGroup>
    <Version>0.1.0</Version>
    <Authors>Enrichment contributors</Authors>
    <Copyright>Copyright (c) 2026 Enrichment contributors</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageTags>source-generator;roslyn;codegen;mediatr;fluentvalidation;validation</PackageTags>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <!-- явный RepositoryUrl вместо SCM-запросов: по нему GitHub Packages привязывает
         пакет к репозиторию, а nuspec не зависит от наличия git-remote на pack -->
    <EnableSourceControlManagerQueries>false</EnableSourceControlManagerQueries>
    <RepositoryUrl>https://github.com/Drenalol/enrichment</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
  </PropertyGroup>

</Project>
